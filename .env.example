# Optional: restart the server after changes. No key is needed for basic extraction.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional outgoing email; enable delivery and enter recipient in Settings too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls or ssl (no plaintext SMTP)
SMTP_SECURITY=starttls
# Keep loopback binding for this single-user application.
PORT=8000
